{
  "name": "organic-app",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack organic products e-commerce application",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm start --workspace client\"",
    "server": "npm run dev --workspace server",
    "client": "npm start --workspace client",
    "install-all": "npm install",
    "build": "npm run build --workspace client"
  },
  "dependencies": {
    "concurrently": "^8.2.0"
  }
}
